# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local scratch (screenshots, design dumps, logs)
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.log
/*.jsonl
/tmp-*
/v-*
/chk-*
/cur-*
/shot-*
/figma-*.json
/measure.json
/outline.txt
/creator-outline.txt
/tree.txt

# agent docs (regenerated locally)
AGENTS.md
CLAUDE.md

